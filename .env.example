# Copy to .env in the repo root for docker compose
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000
SEED_ON_START=true

POSTGRES_USER=eventcart
POSTGRES_PASSWORD=eventcart
POSTGRES_DB=eventcart
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
API_PORT=3000
CLIENT_PORT=5173
